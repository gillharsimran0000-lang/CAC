{
  "name": "civicflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "data:osm": "node scripts/fetch-osm.mjs --all",
    "data:census": "node scripts/fetch-census.mjs",
    "data:graph": "node --max-old-space-size=6144 scripts/build-graph.mjs --all",
    "data:zones": "node --max-old-space-size=6144 scripts/build-zones.mjs --all",
    "data:photos": "node scripts/fetch-photos.mjs",
    "data:photomanifest": "node scripts/build-photos.mjs",
    "data:methodology": "node scripts/build-methodology.mjs",
    "data:calibrate": "tsx scripts/validate/calibrate.ts",
    "data:sweep": "tsx scripts/validate/sweep.ts",
    "data:hero": "tsx scripts/build-hero.ts",
    "data:publish": "cp data/generated/*.json public/data/",
    "data:all": "npm run data:osm && npm run data:census && npm run data:graph && npm run data:zones && npm run data:calibrate && npm run data:sweep && npm run data:hero && npm run data:methodology && npm run data:publish",
    "validate": "tsx scripts/validate/sweep.ts",
    "smoke": "node scripts/validate/smoke.mjs",
    "demo": "tsx scripts/validate/demo.ts",
    "shots": "node scripts/validate/shots.mjs",
    "motion": "node scripts/validate/motion-check.mjs",
    "reduced": "node scripts/validate/reduced-motion.mjs",
    "perf": "node scripts/validate/perf.mjs",
    "check": "node scripts/validate/smoke.mjs && node scripts/validate/flow-check.mjs && node scripts/validate/motion-check.mjs && node scripts/validate/reduced-motion.mjs && node scripts/validate/design-check.mjs",
    "design": "node scripts/validate/design-check.mjs",
    "flow": "node scripts/validate/flow-check.mjs",
    "data:images": "npm run data:photos && npm run data:photomanifest"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "animejs": "^4.5.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "puppeteer": "^25.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
